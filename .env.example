PORT=3000

# Connexion à la base Postgres (obligatoire).
# En local : URL d'une base Postgres locale, ex. postgres://user:pass@localhost:5432/ecoute_anonyme
# En production : l'URL de connexion directe (sans pooling) de la base Neon,
# à coller dans les variables d'environnement du service Render.
DATABASE_URL=

# Mot de passe admin créé au premier démarrage sur une base vide (identifiant
# "admin"). Sans cette variable, c'est "admin123" : à définir en production.
ADMIN_PASSWORD=

# URL publique du site, utilisée dans les emails (lien vers l'espace bénévole)
SITE_URL=http://localhost:3000

# Envoi d'emails (candidatures bénévoles, etc.) via l'API HTTP de Brevo —
# le SMTP sortant est bloqué sur Render, donc pas de Gmail SMTP ici.
# BREVO_API_KEY = clé API v3 -> https://app.brevo.com/settings/keys/api
# BREVO_SENDER_EMAIL = adresse expéditrice, doit être vérifiée dans Brevo
#   -> https://app.brevo.com/senders/list
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Secret partagé avec Netlify (même valeur dans les variables d'environnement
# du site Netlify, portée "Runtime" incluse) : Netlify signe avec lui les
# requêtes /api/* qu'il relaie, ce qui permet au limiteur de connexion de
# connaître l'IP réelle du visiteur. Inutile en local.
NETLIFY_PROXY_SECRET=

# Adresse qui RECOIT les candidatures (par défaut : ecoute.anonyme26@gmail.com)
CONTACT_EMAIL=ecoute.anonyme26@gmail.com
